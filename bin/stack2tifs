#!/usr/bin/env python3
import os
import sys
import argparse
import warnings

from FAST import motility

#Suppress all the warnings
warnings.filterwarnings("ignore")

#Definition of the program
usage            = ['%(prog)s -d [DIRECTORY]',
                    '------------------------------------------------------------------------',
                    'stack2tifs: Utility function to convert stack files to tifs in a folder',
                    '7/21/2021',
                    'Ankit Garg',
                    '',
                    '',
                    'This is a specific version created to explode image stacks and extract',
                    'elapsed times from MicroManager metadata, and write them in a way that',
                    'is compatible with FAST.',
                    '------------------------------------------------------------------------'
                    ]

#Create the parser
parser = argparse.ArgumentParser(description='',usage='\n'.join(usage))
parser.add_argument('-d',help='top directory of the stack files to be converted to tif files')
parser.add_argument('-s',help='Lower bound for the size(Mbytes) of tif files to be converted',default=6,type=float)
parser.add_argument('-f',help='Frame rate for the movies',default=1,type=float)
parser.add_argument('-t',help='Use elapsed times from Micromanager *_metadata.txt file where * = same file name as image stack. To activate, write "y" or "yes". "f" argument will be ignored.',default=False)
parser.add_argument('-o',help='Overwrite already-exploded tif frames if they exist. Write "y" or "yes" to overwrite (Default: no - skip already-exploded stacks)',default='no')
args = parser.parse_args()
args_dict = vars(args)
parser.print_help()


#Get the argument
main_dir   = args_dict['d']
min_size   = args_dict['s']
frame_rate = args_dict['f']
extract_metadata = args_dict['t']
overwrite  = str(args_dict['o']).lower() in ('y','yes')

#Check if the directory exists
if main_dir == None or not os.path.isdir(main_dir):
    sys.exit("\nDirectory doesn't exist. Program is exiting.")

'''
Recurse through each data directory
'''
for root, subFolders, files in os.walk(main_dir):
    #Exclude files already named with the img_NNN__TAIL.tif convention that
    #stack_to_tiffs_py3 writes - without this, lowering -s below an
    #individual exploded frame's size makes the walk descend into a stack's
    #own exploded-frames subfolder and try to re-explode each single frame
    #as if it were itself a multi-frame stack
    tif_files = list(filter(lambda f: os.path.getsize(root+'/'+f)*1E-6 > min_size and os.path.splitext(f)[1] == '.tif' and not f.startswith('img_'), files))
    for tif_file in tif_files:
        fname = root+'/'+tif_file

        #Check if this stack has already been exploded into individual frames
        exploded_dir     = motility.get_exploded_dir(fname)
        already_exploded = os.path.isdir(exploded_dir) and len(list(filter(lambda f: f.endswith('.tif'),os.listdir(exploded_dir)))) > 0

        if already_exploded and not overwrite:
            print("Exploded frames already exist in {} - skipping {}".format(exploded_dir,fname))
            continue

        if already_exploded and overwrite:
            print("Exploded frames already exist in {} - overwriting {}".format(exploded_dir,fname))

        #Report which file failed and keep going, rather than letting one
        #bad/unexpected stack file (e.g. corrupt, truncated, or an
        #unexpected format) abort the whole batch with a bare traceback
        try:
            motility.stack_to_tiffs_py3(fname,frame_rate,extract_metadata)
        except Exception as e:
            print("Error exploding {}: {} - skipping".format(fname,e))
            continue
